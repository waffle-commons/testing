{
    "name": "waffle-commons/testing",
    "description": "Kernel testing bridge for the Waffle framework: in-process request dispatch through the real pipeline, plus time, queue, mailer and HTTP-client test doubles.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Waffle\\Commons\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WaffleTests\\Commons\\Testing\\": "tests/src/"
        }
    },
    "authors": [
        {
            "name": "Leslie Petrimaux",
            "email": "contact@waffle-commons.cloud"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "waffle-commons/contracts": "self.version",
        "phpunit/phpunit": "^12.5",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "vimeo/psalm": "^6.20",
        "php-mock/php-mock-phpunit": "^2.16",
        "cyclonedx/cyclonedx-php-composer": "^6.2",
        "igor-php/igor-php": "^0.10.1",
        "nyholm/psr7": "^1.8"
    },
    "scripts": {
        "formatter": "vendor/bin/mago fmt",
        "linter": "vendor/bin/mago lint",
        "analyzer": "vendor/bin/mago analyze",
        "guard": "vendor/bin/mago guard",
        "igor": "vendor/bin/igor-php .",
        "phpunit": "vendor/bin/phpunit --log-junit var/data/phpunit-coverage/junit.xml --coverage-html var/data/phpunit-coverage",
        "mago": [
            "@formatter",
            "@linter",
            "@analyzer",
            "@guard"
        ],
        "tests": [
            "@phpunit"
        ],
        "scan": [
            "@mago",
            "@tests"
        ],
        "ci": [
            "@mago",
            "@tests",
            "composer audit",
            "vendor/bin/psalm --taint-analysis"
        ]
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true,
            "cyclonedx/cyclonedx-php-composer": true
        }
    }
}
